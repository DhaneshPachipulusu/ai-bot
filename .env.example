# ==========================================
# AI Interview Bot — Environment Variables
# Copy to .env and fill in real values.
# ==========================================

# --- AI / LLM Providers ---
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=
# Gemini model the backend calls (gemini-2.0-flash was retired)
GEMINI_MODEL=gemini-2.5-flash
# Force scripted fallback instead of calling the LLM (true/false)
USE_MOCK_AI=false

# --- App ---
APP_ENV=production
LOG_LEVEL=info

# --- Backend ---
# SQLite file path (point to a mounted volume in Docker/k8s)
DATABASE_PATH=interview_bot.db
# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Interview defaults
DEFAULT_MAX_QUESTIONS=10
DEFAULT_MAX_DURATION_MINS=25

# --- Frontend ---
# Public URL the browser will use to reach the API (through nginx in prod)
NEXT_PUBLIC_API_URL=http://localhost

# --- Container image registry & tag (used by docker-compose.prod.yml) ---
REGISTRY=ghcr.io/yourorg
TAG=latest
